# =============================================================================
# BlackTrader Automation Suite - configuration
# Copy this file to .env and fill it in:      cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# Verify your setup any time with:            python scripts/doctor.py
# =============================================================================

# --- Platform --------------------------------------------------------------
BASE_URL=https://lpadmin.blackfx.com

# --- Credentials (required) ------------------------------------------------
# Admin login for lpadmin (used to read members, set balances, create accounts)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
# One shared password used by the master and every follower account
MEMBER_PASSWORD=your_member_password

# --- Copy-trading topology -------------------------------------------------
# The master (leader) account and its client id. The id is shown in the admin panel
# (looks like mem_xxxxxxxxxxxxxxxxxx).
MASTER_EMAIL=ctmaster@mailinator.com
MASTER_ID=mem_xxxxxxxxxxxxxxxxxx

# Followers are named <prefix><n>@<domain>, n = 1..FOLLOWER_COUNT
DEFAULT_EMAIL_PREFIX=follower
DEFAULT_EMAIL_DOMAIN=mailinator.com
FOLLOWER_COUNT=100

# Used by `python main.py create`
DEFAULT_BALANCE=100000000
DEFAULT_INSTANCES=paper,real

# --- Dashboard (optional) --------------------------------------------------
# Binds to localhost only by default. To share it on your network you MUST set a token;
# people then open  http://<your-ip>:5000/?token=<DASHBOARD_TOKEN>  once.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_TOKEN=
