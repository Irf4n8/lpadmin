# BlackTrader Configuration & Credentials Template
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

BASE_URL=https://lpadmin.blackfx.com
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
MEMBER_PASSWORD=your_member_password

# Default Account Generation Settings
DEFAULT_BALANCE=100000000
DEFAULT_EMAIL_PREFIX=follower
DEFAULT_EMAIL_DOMAIN=mailinator.com
DEFAULT_INSTANCES=paper,real

# --- Dashboard / copy-trading topology (optional; these are the defaults) ---
MASTER_EMAIL=ctmaster@mailinator.com
MASTER_ID=mem_xxxxxxxxxxxxxxxxxx
FOLLOWER_PREFIX=follower
FOLLOWER_COUNT=100
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
# Optional: when set, open http://<host>:5000/?token=<DASHBOARD_TOKEN> once
DASHBOARD_TOKEN=
