<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MAM Production Race Test Plan">
      <stringProp name="TestPlan.comments">Credential-free MAM real-hedging race plan. Write tests require -Jenable_writes=true and dedicated test accounts.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="protocol" elementType="Argument"><stringProp name="Argument.name">protocol</stringProp><stringProp name="Argument.value">${__P(protocol,https)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="master_email" elementType="Argument"><stringProp name="Argument.name">master_email</stringProp><stringProp name="Argument.value">${__P(master_email,mamm@mailinator.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="member_password" elementType="Argument"><stringProp name="Argument.name">member_password</stringProp><stringProp name="Argument.value">${__P(member_password,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="symbol" elementType="Argument"><stringProp name="Argument.name">symbol</stringProp><stringProp name="Argument.value">${__P(symbol,BLACK:BTCUSD)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="race_request_id" elementType="Argument"><stringProp name="Argument.name">race_request_id</stringProp><stringProp name="Argument.value">${__P(race_request_id,jm_retry_probe_001)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="race_group_id" elementType="Argument"><stringProp name="Argument.name">race_group_id</stringProp><stringProp name="Argument.value">${__P(race_group_id,jm_group_probe_001)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
        <stringProp name="HTTPSampler.domain">${host}</stringProp>
        <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">15000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="01 - Read-only real-hedging preflight">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="Session Cookies"><collectionProp name="CookieManager.cookies"/><boolProp name="CookieManager.clearEachIteration">true</boolProp></CookieManager><hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON Headers"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Login master">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;email&quot;:&quot;${master_email}&quot;,&quot;password&quot;:&quot;${member_password}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
          <stringProp name="HTTPSampler.path">/api/auth/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Login success"><stringProp name="JSON_PATH">$.success</stringProp><stringProp name="EXPECTED_VALUE">true</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/></hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get chart token"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/auth/chart-token</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
        <hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract bearer token"><stringProp name="JSONPostProcessor.referenceNames">token</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.token</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp></JSONPostProcessor><hashTree/></hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="OMS Authorization"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${token}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Broker-ID</stringProp><stringProp name="Header.value">real</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Confirm real hedging"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/info</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
        <hashTree>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Real instance"><stringProp name="JSON_PATH">$.slug</stringProp><stringProp name="EXPECTED_VALUE">real</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="JSONVALIDATION_NEGATE">false</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Hedging mode"><stringProp name="JSON_PATH">$.mode</stringProp><stringProp name="EXPECTED_VALUE">hedging</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="JSONVALIDATION_NEGATE">false</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Verify master starts flat"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/positions</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
        <hashTree><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="No starting positions"><stringProp name="JSON_PATH">$.count</stringProp><stringProp name="EXPECTED_VALUE">0</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="JSONVALIDATION_NEGATE">false</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/></hashTree>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="02 - Duplicate request delivery race (write gated)">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">2</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Writes explicitly enabled"><stringProp name="IfController.condition">${__groovy(props.get('enable_writes') == 'true')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
        <hashTree>
          <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="Per-thread session cookies"><collectionProp name="CookieManager.cookies"/><boolProp name="CookieManager.clearEachIteration">true</boolProp></CookieManager><hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON Headers"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Race login master"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;email&quot;:&quot;${master_email}&quot;,&quot;password&quot;:&quot;${member_password}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/auth/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Race chart token"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/auth/chart-token</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract race token"><stringProp name="JSONPostProcessor.referenceNames">token</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.token</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp></JSONPostProcessor><hashTree/></hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Race OMS Authorization"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${token}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Broker-ID</stringProp><stringProp name="Header.value">real</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <SynchronizingTimer guiclass="TestBeanGUI" testclass="SynchronizingTimer" testname="Release both duplicate requests together"><intProp name="groupSize">2</intProp><longProp name="timeoutInMs">20000</longProp></SynchronizingTimer><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST identical market request"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;symbol&quot;:&quot;${symbol}&quot;,&quot;side&quot;:&quot;BUY&quot;,&quot;qty&quot;:0.01,&quot;type&quot;:&quot;MARKET&quot;,&quot;request_id&quot;:&quot;${race_request_id}&quot;,&quot;group_id&quot;:&quot;${race_group_id}&quot;,&quot;source&quot;:&quot;jmeter&quot;,&quot;tag&quot;:&quot;QA_JMETER_RACE&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/orders</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract created market order"><stringProp name="JSONPostProcessor.referenceNames">market_order_id</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.position.market_order_id</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues"></stringProp></JSONPostProcessor><hashTree/></hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Allow MAM fanout"><stringProp name="ConstantTimer.delay">1500</stringProp></ConstantTimer><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Read back duplicate exposure"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/positions</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Exactly one position for stable request identity"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">mam_duplicate_readback_v1</stringProp><stringProp name="script"><![CDATA[def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def matches = (body.positions ?: []).findAll { it.group_id == vars.get('race_group_id') }
if (matches.size() != 1) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Expected one position for request/group identity; observed ${matches.size()}")
}]]></stringProp></JSR223Assertion><hashTree/></hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Cleanup this thread's accepted order"><stringProp name="IfController.condition">${__groovy(vars.get('market_order_id')?.trim())}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController>
          <hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Close created position"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/positions/${market_order_id}/squareoff</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/></hashTree>
          <SynchronizingTimer guiclass="TestBeanGUI" testclass="SynchronizingTimer" testname="Wait for both cleanups"><intProp name="groupSize">2</intProp><longProp name="timeoutInMs">20000</longProp></SynchronizingTimer><hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Verify duplicate test cleanup"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/v1/oms/real/positions</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="No positions remain for test group"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">mam_duplicate_cleanup_v1</stringProp><stringProp name="script"><![CDATA[def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def matches = (body.positions ?: []).findAll { it.group_id == vars.get('race_group_id') }
if (!matches.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Cleanup failure: ${matches.size()} test positions remain")
}]]></stringProp></JSR223Assertion><hashTree/></hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
